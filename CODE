-- 3. TRIGGERS
-- ------------------------------------------------------------

DELIMITER //

CREATE TRIGGER trg_validate_review
BEFORE INSERT ON Reviews
FOR EACH ROW
BEGIN
    IF NEW.Rating < 1 OR NEW.Rating > 5 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Rating must be between 1 and 5';
    END IF;
END//

CREATE TRIGGER trg_validate_payment
BEFORE INSERT ON Payments
FOR EACH ROW
BEGIN
    IF NEW.Amount <= 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Payment amount must be greater than zero';
    END IF;
END//

CREATE TRIGGER trg_validate_refund
BEFORE INSERT ON Refunds
FOR EACH ROW
BEGIN
    IF NEW.Refund_Amount <= 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Refund amount must be greater than zero';
    END IF;
END//

DELIMITER ;

-- ------------------------------------------------------------
-- 4. STORED PROCEDURES
-- ------------------------------------------------------------

DELIMITER //

CREATE PROCEDURE get_movie_shows(IN p_movie_id INT)
BEGIN
    SELECT
        M.Title,
        S.Show_Date,
        S.Show_Time,
        SC.Screen_Name,
        T.Theatre_Name,
        T.City,
        S.Ticket_Price
    FROM Shows AS S
    JOIN Movies AS M ON S.Movie_ID = M.Movie_ID
    JOIN Screens AS SC ON S.Screen_ID = SC.Screen_ID
    JOIN Theatres AS T ON SC.Theatre_ID = T.Theatre_ID
    WHERE M.Movie_ID = p_movie_id
    ORDER BY S.Show_Date, S.Show_Time;
END//

CREATE PROCEDURE get_user_bookings(IN p_user_id INT)
BEGIN
    SELECT
        B.Booking_ID,
        U.Name,
        M.Title,
        S.Show_Date,
        S.Show_Time,
        B.Total_Amount,
        B.Booking_Status
    FROM Bookings AS B
    JOIN Users AS U ON B.User_ID = U.User_ID
    JOIN Shows AS S ON B.Show_ID = S.Show_ID
    JOIN Movies AS M ON S.Movie_ID = M.Movie_ID
    WHERE U.User_ID = p_user_id
    ORDER BY B.Booking_Date DESC;
END//

CREATE PROCEDURE get_movie_reviews(IN p_movie_id INT)
BEGIN
    SELECT
        M.Title,
        U.Name,
        R.Rating,
        R.Comment,
        R.Review_Date
    FROM Reviews AS R
    JOIN Movies AS M ON R.Movie_ID = M.Movie_ID
    JOIN Users AS U ON R.User_ID = U.User_ID
    WHERE M.Movie_ID = p_movie_id
    ORDER BY R.Review_Date DESC;
END//

DELIMITER ;

-- ------------------------------------------------------------
-- 5. JOIN QUERIES AND REPORTS
-- ------------------------------------------------------------

-- A. Display all movies and their show timings
SELECT M.Title, S.Show_Date, S.Show_Time, S.Ticket_Price
FROM Movies AS M
JOIN Shows AS S ON M.Movie_ID = S.Movie_ID;

-- B. Display theatres and their screens
SELECT T.Theatre_Name, T.City, SC.Screen_Name, SC.Capacity
FROM Theatres AS T
JOIN Screens AS SC ON T.Theatre_ID = SC.Theatre_ID;

-- C. Display customer booking details
SELECT
    B.Booking_ID, U.Name, M.Title,
    S.Show_Date, S.Show_Time,
    B.Total_Amount, B.Booking_Status
FROM Bookings AS B
JOIN Users AS U ON B.User_ID = U.User_ID
JOIN Shows AS S ON B.Show_ID = S.Show_ID
JOIN Movies AS M ON S.Movie_ID = M.Movie_ID;

-- D. Display payments for all bookings, including unpaid bookings
SELECT
    B.Booking_ID, B.Total_Amount,
    P.Payment_ID, P.Amount, P.Payment_Method, P.Payment_Status
FROM Bookings AS B
LEFT JOIN Payments AS P ON B.Booking_ID = P.Booking_ID;

-- E. Display movie reviews with customer names
SELECT M.Title, U.Name, R.Rating, R.Comment, R.Review_Date
FROM Reviews AS R
JOIN Movies AS M ON R.Movie_ID = M.Movie_ID
JOIN Users AS U ON R.User_ID = U.User_ID;

-- F. Calculate average review rating for each movie
SELECT
    M.Title,
    ROUND(AVG(R.Rating), 2) AS Average_Rating,
    COUNT(R.Review_ID) AS Total_Reviews
FROM Movies AS M
LEFT JOIN Reviews AS R ON M.Movie_ID = R.Movie_ID
GROUP BY M.Movie_ID, M.Title
ORDER BY Average_Rating DESC;

-- G. Display refund details with original payment information
SELECT
    R.Refund_ID, P.Booking_ID,
    R.Refund_Amount, R.Refund_Date, R.Refund_Status
FROM Refunds AS R
JOIN Payments AS P ON R.Payment_ID = P.Payment_ID;

-- H. Count bookings for every customer, including customers with zero bookings
SELECT U.User_ID, U.Name, COUNT(B.Booking_ID) AS Total_Bookings
FROM Users AS U
LEFT JOIN Bookings AS B ON U.User_ID = B.User_ID
GROUP BY U.User_ID, U.Name;

-- I. Total number of movies
SELECT COUNT(*) AS Total_Movies FROM Movies;

-- J. Total number of bookings
SELECT COUNT(*) AS Total_Bookings FROM Bookings;

-- K. Total recorded booking amount (not necessarily collected revenue)
SELECT SUM(Total_Amount) AS Total_Booking_Amount FROM Bookings;

-- L. Payment status report
SELECT
    B.Booking_ID, U.Name, B.Total_Amount,
    P.Amount AS Payment_Amount, P.Payment_Method, P.Payment_Status
FROM Bookings AS B
JOIN Users AS U ON B.User_ID = U.User_ID
LEFT JOIN Payments AS P ON B.Booking_ID = P.Booking_ID;

-- M. Refund report
SELECT
    R.Refund_ID, P.Booking_ID,
    R.Refund_Amount, R.Refund_Date, R.Refund_Status
FROM Refunds AS R
JOIN Payments AS P ON R.Payment_ID = P.Payment_ID;

